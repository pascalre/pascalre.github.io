---
import Logo from './Logo.astro';
import { formatMonth, type PostItem } from '../lib/posts';
// Logo file: "solace.com" -> solace.svg, "DEV" -> dev.svg,
// "The Retail Optimiser" -> the-retail-optimiser.svg, or set `logo:` in posts.yml
const platform = (where: string) => where.replace(/\.(com|io|dev|de|org|net)$/, '');
interface Props { posts: PostItem[] }
const { posts } = Astro.props;
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <a href={p.url} {...(p.local ? {} : { target: '_blank', rel: 'noopener' })}>
        <span class="post-title">{p.title}</span>
        <span class="post-meta">
          {p.date && <time datetime={p.date.toISOString().slice(0, 10)}>{formatMonth(p.date)}</time>}
          {p.minutes && <span>{p.minutes} min</span>}
          {p.local ? <span>{p.where}</span> : <span class="post-where"><Logo name={platform(p.where)} icon={p.logo} />{p.where}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>
