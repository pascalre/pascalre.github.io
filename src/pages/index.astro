---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Photo from '../components/Photo.astro';
import { photo, isLandscape } from '../lib/photos';
import Socials from '../components/Socials.astro';
import Portrait from '../components/Portrait.astro';
import PostList from '../components/PostList.astro';
import { profile, about, experience, skills } from '../lib/data';
import { withStars } from '../lib/github';
import { getAllPosts } from '../lib/posts';

const posts = await getAllPosts();
const projects = await withStars();
const LATEST = 5;
---
<Base>
  <section class="hero" id="top">
    <div class="hero-text">
      <h1>Hi, I’m {profile.first_name}.</h1>
      <p class="lede">{profile.role}, based in {profile.location}. {profile.intro}</p>
      <Socials />
    </div>
    <Portrait />
  </section>

  <section class="section" id="about" aria-labelledby="about-h">
    <h2 id="about-h">Away from the keyboard</h2>
    <div class="tiles">
      {about.map((t) => {
        const img = photo(t.photo);
        const hasText = !!(t.title || t.text || t.items);
        if (t.photo && !img && !hasText && !import.meta.env.DEV) return null;
        const cls = ['tile', `tile--${t.color ?? 'sky'}`, `tile--${t.size ?? 'normal'}`, (img || (t.photo && import.meta.env.DEV)) && 'tile--photo', !hasText && 'tile--bare'];
        return (
          <article class:list={cls}>
            {t.photo && <Photo src={t.photo} alt={t.alt ?? t.title ?? ''} position={t.position} class="tile-img"
              sizes={t.size === 'wide' ? '(max-width: 560px) 92vw, (max-width: 860px) 92vw, 34rem' : '(max-width: 560px) 92vw, (max-width: 860px) 46vw, 17rem'} />}
            {hasText && (
              <div class="tile-body">
                {t.emoji && !img && <span class="tile-emoji" aria-hidden="true">{t.emoji}</span>}
                {t.title && <h3>{t.title}</h3>}
                {t.text && <p>{t.text}</p>}
                {t.items && <ul>{t.items.map((i) => <li>{i}</li>)}</ul>}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-h">
    <h2 id="work-h">Things I build and maintain</h2>
    <ul class="projects">
      {projects.map((p) => (
        <li class="project">
          <a class="project-link" href={p.url} target="_blank" rel="noopener">
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <p class="project-meta">
              <span>{p.role}</span>
              <span>{p.language}</span>
              {p.repo && (
                <span class="stars" hidden={!p.stars}>
                  <Icon name="star" /><span>{p.stars}</span>
                  <span class="visually-hidden"> stars on GitHub</span>
                </span>
              )}
            </p>
          </a>
        </li>
      ))}
    </ul>
    <p class="more"><a href="https://github.com/pascalre" target="_blank" rel="noopener">More on GitHub</a></p>

    <h2 class="sub">Where I’ve worked</h2>
    <ol class="timeline">
      {experience.map((e) => (
        <li>
          <p class="when">{e.period}</p>
          <div>
            <div class="job-head">
              <Logo name={e.company} icon={e.logo} class="logo--badge" />
              <div>
                <h3>{e.role}</h3>
                <p class="where">{e.company}</p>
              </div>
            </div>
            {e.points && <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>}
            {e.photos?.some((ph) => photo(ph.src) || import.meta.env.DEV) && (
              <div class="job-photos">
                {e.photos.map((ph) => {
                  const img = photo(ph.src);
                  if (!img && !import.meta.env.DEV) return null;
                  const wide = img ? isLandscape(img) : false;
                  return (
                    <figure class:list={['job-photo', wide ? 'job-photo--wide' : 'job-photo--tall']}>
                      <Photo src={ph.src} alt={ph.alt} position={ph.position}
                        sizes={wide ? '(max-width: 560px) 85vw, 26rem' : '(max-width: 560px) 40vw, 12rem'} />
                      {ph.caption && <figcaption>{ph.caption}</figcaption>}
                    </figure>
                  );
                })}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-h">
    <h2 id="skills-h">What I work with</h2>
    <div class="skills">
      <div>
        <h3 class="group">Certifications</h3>
        <ul class="certs">
          {skills.certifications.map((c) => (
            <li>
              <Logo name={c.issuer} icon={c.logo} class="logo--badge" />
              {c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name}</a> : <strong>{c.name}</strong>}
              <span>{c.issuer}{c.status && `, ${c.status.toLowerCase()}`}</span>
            </li>
          ))}
        </ul>
      </div>
      <dl class="stack">
        {skills.stack.map((g) => (
          <div>
            <dt>{g.group}</dt>
            <dd><ul>{g.items.map((i) => {
              const item = typeof i === 'string' ? { name: i } : i;
              return <li><Logo name={item.name} icon={item.icon} />{item.name}</li>;
            })}</ul></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" id="articles" aria-labelledby="articles-h">
    <h2 id="articles-h">Articles</h2>
    <PostList posts={posts.slice(0, LATEST)} />
    {posts.length > LATEST && <p class="more"><a href="/blog/">All {posts.length} articles</a></p>}
  </section>
</Base>
