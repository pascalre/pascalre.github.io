---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatMonth } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="article">
    <p class="article-meta">
      <a href="/blog/">Writing</a>
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatMonth(post.data.date)}</time>
      {post.data.draft && <span class="draft">Draft</span>}
    </p>
    <h1>{post.data.title}</h1>
    {post.data.description && <p class="lede">{post.data.description}</p>}
    <div class="prose"><Content /></div>
  </article>
</Base>
